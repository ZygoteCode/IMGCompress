<Project>
  <!-- Shared settings for every Carbonado project. -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Product>Carbonado</Product>
    <Company>ZygoteCode</Company>
    <Authors>ZygoteCode</Authors>
    <Copyright>© 2026 ZygoteCode — GPL-3.0</Copyright>
    <Version>7.0.0</Version>
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
    <InformationalVersion>7.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- CA rules that fight WPF/P-Invoke idioms or are pure style. -->
    <NoWarn>$(NoWarn);CA1001;CA1002;CA1003;CA1008;CA1010;CA1014;CA1028;CA1031;CA1032;CA1034;CA1040;CA1051;CA1062;CA1060;CA1064;CA1303;CA1305;CA1307;CA1308;CA1309;CA1310;CA1311;CA1401;CA1416;CA1419;CA1502;CA1506;CA1508;CA1515;CA1707;CA1708;CA1710;CA1711;CA1716;CA1720;CA1724;CA1725;CA1805;CA1810;CA1812;CA1814;CA1815;CA1819;CA1822;CA1824;CA1835;CA1838;CA1847;CA1848;CA1849;CA1850;CA1852;CA1859;CA1860;CA1861;CA1862;CA1863;CA1865;CA1866;CA1867;CA1869;CA1870;CA1871;CA1872;CA1873;CA1874;CA1875;CA2000;CA2007;CA2008;CA2012;CA2201;CA2211;CA2213;CA2225;CA2227;CA2234;CA2249;CA2263;CA5350;CA5351;CA5392;CA5394;SYSLIB1054;SYSLIB1045;IDE0005;CS1591</NoWarn>
  </PropertyGroup>
</Project>
