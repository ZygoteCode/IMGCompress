<UserControl x:Class="Carbonado.App.Shell.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Carbonado.UI.Controls;assembly=Carbonado.UI"
             MinWidth="380" MaxWidth="500"
             AutomationProperties.AutomationId="Dialog">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ui:IconPresenter x:Name="Glyph" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="Dialog.Title" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Foreground="{StaticResource B.TextSecondary}"
                   TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,22" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" Style="{StaticResource Button.Ghost}" MinWidth="96" Margin="0,0,10,0"
                    Click="OnSecondary" IsCancel="True" AutomationProperties.AutomationId="Dialog.Secondary" />
            <Button x:Name="PrimaryButton" MinWidth="120" Click="OnPrimary" IsDefault="True"
                    AutomationProperties.AutomationId="Dialog.Primary" />
        </StackPanel>
    </StackPanel>
</UserControl>
