<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Carbonado.UI.Theme">
    <!--
        Selection controls: CheckBox (the check draws itself in), RadioButton (prismatic pip settles in),
        Toggle.Switch (thumb glides along a Prisma track) and Radio.Chip (pill choice). Unchecked outlines use
        Mist500 for 3:1 non-text contrast; state changes glide via generated transitions (instant under reduced motion).
    -->
    <ResourceDictionary.MergedDictionaries>
        <theme:SharedDictionary Source="/Carbonado.UI;component/Theme/Styles/Base.xaml" />
        <theme:SharedDictionary Source="/Carbonado.UI;component/Theme/Styles/Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Selection.Base" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Transparent}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Prisma.Small}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== CheckBox ===== -->
    <ControlTemplate x:Key="Template.CheckBox" TargetType="ToggleButton">
        <Grid x:Name="Root" Background="{TemplateBinding Background}"
              VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.TextDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Standard}" GeneratedEasingFunction="{StaticResource Ease.Crystallize}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Indeterminate">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="Box" Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BoxScale" />
                </Grid.RenderTransform>
                <Border CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource B.TextTertiary}" Background="{StaticResource B.Obsidian900}" />
                <Border x:Name="BoxHover" Opacity="0" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource B.TextSecondary}" Background="{StaticResource B.White.A04}" />
                <Border x:Name="Fill" Opacity="0" CornerRadius="5" Background="{StaticResource B.Prisma}" />
                <Path x:Name="Mark" Data="M4.6,9.3 L7.7,12.3 L13.4,6.2" Stroke="{StaticResource B.Obsidian950}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="7 7" StrokeDashOffset="7" />
                <Rectangle x:Name="Dash" Opacity="0" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource B.Obsidian950}" />
            </Grid>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="CheckBox" BasedOn="{StaticResource Selection.Base}">
        <Setter Property="Template" Value="{StaticResource Template.CheckBox}" />
    </Style>

    <!-- ===== RadioButton ===== -->
    <ControlTemplate x:Key="Template.RadioButton" TargetType="ToggleButton">
        <Grid x:Name="Root" Background="{TemplateBinding Background}"
              VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DotHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DotHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.TextDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Standard}" GeneratedEasingFunction="{StaticResource Ease.Settle}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="Dot" Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="DotScale" />
                </Grid.RenderTransform>
                <Ellipse Stroke="{StaticResource B.TextTertiary}" StrokeThickness="1.5" Fill="{StaticResource B.Obsidian900}" />
                <Ellipse x:Name="DotHover" Opacity="0" Stroke="{StaticResource B.TextSecondary}" StrokeThickness="1.5" Fill="{StaticResource B.White.A04}" />
                <Ellipse x:Name="Ring" Opacity="0" Stroke="{StaticResource B.Prisma}" StrokeThickness="1.5" Fill="{StaticResource B.Iris.A15}" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Prisma}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PipScale" ScaleX="0" ScaleY="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="RadioButton" BasedOn="{StaticResource Selection.Base}">
        <Setter Property="Template" Value="{StaticResource Template.RadioButton}" />
    </Style>

    <!-- ===== Toggle.Switch ===== -->
    <ControlTemplate x:Key="Template.Switch" TargetType="ToggleButton">
        <Grid x:Name="Root" Background="{TemplateBinding Background}"
              VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.TextDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Standard}" GeneratedEasingFunction="{StaticResource Ease.Crystallize}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="16" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="Track" Width="38" Height="22" VerticalAlignment="Center">
                <Border CornerRadius="11" BorderThickness="1.5" BorderBrush="{StaticResource B.TextTertiary}" Background="{StaticResource B.Obsidian900}" />
                <Border x:Name="On" Opacity="0" CornerRadius="11" Background="{StaticResource B.Prisma}" />
                <Border x:Name="TrackHover" Opacity="0" CornerRadius="11" Background="{StaticResource B.White.A08}" />
                <Grid Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="KnobScale" />
                            <TranslateTransform x:Name="KnobX" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse Fill="{StaticResource B.TextSecondary}" />
                    <Ellipse x:Name="KnobOn" Opacity="0" Fill="{StaticResource B.Diamond50}" />
                </Grid>
            </Grid>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Toggle.Switch" TargetType="ToggleButton" BasedOn="{StaticResource Selection.Base}">
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Prisma.Pill}" />
        <Setter Property="Template" Value="{StaticResource Template.Switch}" />
    </Style>

    <!-- ===== Radio.Chip: pill choice built on the layered button template ===== -->
    <Style x:Key="Radio.Chip" TargetType="RadioButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource B.White.A04}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.White.A08}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <!-- Half the height (a huge CornerRadius would turn a wide Border into an ellipse). -->
        <Setter Property="theme:Chrome.CornerRadius" Value="16" />
        <Setter Property="theme:Chrome.HoverBackground" Value="{StaticResource B.White.A04}" />
        <Setter Property="theme:Chrome.HoverBorderBrush" Value="{StaticResource B.White.A12}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Prisma.Pill}" />
    </Style>
</ResourceDictionary>
