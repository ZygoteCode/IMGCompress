<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Carbonado.UI.Theme"
                    xmlns:c="clr-namespace:Carbonado.UI.Controls">
    <!--
        Text inputs: a recessed obsidian well with a hairline edge; focus lights the edge in iris and grows a
        prismatic underline from the center. Optional leading icon (Chrome.Icon) and placeholder (Chrome.Placeholder).
    -->
    <ResourceDictionary.MergedDictionaries>
        <theme:SharedDictionary Source="/Carbonado.UI;component/Theme/Styles/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Input.Base" TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Obsidian950}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.White.A12}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="theme:Chrome.CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </Style>

    <!-- Layers: well, hover edge, focus edge + glow, underline; PasswordBox below mirrors them without placeholder. -->
    <ControlTemplate x:Key="Template.TextBox" TargetType="TextBox">
        <Grid x:Name="Root" VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="ReadOnly">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Well" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Standard}" GeneratedEasingFunction="{StaticResource Ease.Crystallize}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Well" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="HoverEdge" Opacity="0" BorderBrush="{StaticResource B.White.A20}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="FocusEdge" Opacity="0" Background="{StaticResource B.White.A04}" BorderBrush="{StaticResource B.Iris.A35}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Rectangle Height="2" VerticalAlignment="Bottom" Margin="10,0" RadiusX="1" RadiusY="1" Fill="{StaticResource B.Prisma}"
                       RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="UnderlineScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:IconPresenter x:Name="Icon" Icon="{TemplateBinding theme:Chrome.Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                 Foreground="{StaticResource B.TextTertiary}" VerticalAlignment="Center" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="2,0" Text="{TemplateBinding theme:Chrome.Placeholder}"
                           Foreground="{StaticResource B.TextTertiary}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" Background="{x:Null}"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="theme:Chrome.Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox" BasedOn="{StaticResource Input.Base}">
        <Setter Property="CaretBrush" Value="{StaticResource B.Aqua}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Iris}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="Template" Value="{StaticResource Template.TextBox}" />
    </Style>

    <ControlTemplate x:Key="Template.PasswordBox" TargetType="PasswordBox">
        <Grid x:Name="Root" VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Standard}" GeneratedEasingFunction="{StaticResource Ease.Crystallize}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="HoverEdge" Opacity="0" BorderBrush="{StaticResource B.White.A20}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="FocusEdge" Opacity="0" Background="{StaticResource B.White.A04}" BorderBrush="{StaticResource B.Iris.A35}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Rectangle Height="2" VerticalAlignment="Bottom" Margin="10,0" RadiusX="1" RadiusY="1" Fill="{StaticResource B.Prisma}"
                       RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="UnderlineScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" Background="{x:Null}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource Input.Base}">
        <Setter Property="CaretBrush" Value="{StaticResource B.Aqua}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Iris}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="PasswordChar" Value="•" />
        <Setter Property="Template" Value="{StaticResource Template.PasswordBox}" />
    </Style>
</ResourceDictionary>
