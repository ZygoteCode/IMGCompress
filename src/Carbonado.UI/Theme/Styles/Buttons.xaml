<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Carbonado.UI.Theme"
                    xmlns:c="clr-namespace:Carbonado.UI.Controls">
    <!--
        Buttons. One layered template serves Button/RepeatButton/ToggleButton and the Secondary, Ghost, Icon and
        Danger looks (layers fade in by opacity; the chrome presses in by 3 %). Primary has its own template:
        Prisma gradient, inner bevel, iris glow and a sheen that sweeps across on hover.
    -->
    <ResourceDictionary.MergedDictionaries>
        <theme:SharedDictionary Source="/Carbonado.UI;component/Theme/Styles/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="Template.Button" TargetType="ButtonBase">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True"
              VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Press" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                        <VisualTransition To="Pressed" GeneratedDuration="{StaticResource Duration.Micro}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.Text}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.Text}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.TextDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Indeterminate">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="Hover" Opacity="0" Background="{TemplateBinding theme:Chrome.HoverBackground}"
                    BorderBrush="{TemplateBinding theme:Chrome.HoverBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="Selected" Opacity="0" Background="{StaticResource B.Iris.A15}" BorderBrush="{StaticResource B.Prisma}"
                    BorderThickness="1" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="Shade" Opacity="0" Background="{StaticResource B.Black.A40}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <StackPanel x:Name="Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                <c:IconPresenter x:Name="Icon" Icon="{TemplateBinding theme:Chrome.Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="theme:Chrome.Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.White.A04}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="theme:Chrome.CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="theme:Chrome.HoverBackground" Value="{StaticResource B.White.A04}" />
        <Setter Property="theme:Chrome.HoverBorderBrush" Value="{StaticResource B.White.A20}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Prisma}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />
    <Style TargetType="RepeatButton" BasedOn="{StaticResource Button.Base}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}" />

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}" />

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource B.Transparent}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Transparent}" />
        <Setter Property="theme:Chrome.HoverBackground" Value="{StaticResource B.White.A08}" />
        <Setter Property="theme:Chrome.HoverBorderBrush" Value="{StaticResource B.Transparent}" />
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource B.Ruby.A15}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke.Danger}" />
        <Setter Property="theme:Chrome.HoverBackground" Value="{StaticResource Fill.DangerHover}" />
        <Setter Property="theme:Chrome.HoverBorderBrush" Value="{StaticResource B.Ruby}" />
    </Style>

    <!-- ===== Primary: Prisma gradient, bevel, glow and hover sheen ===== -->
    <ControlTemplate x:Key="Template.Button.Primary" TargetType="ButtonBase">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"
              VisualStateManager.CustomVisualStateManager="{StaticResource Motion.StateManager}">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Press" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource Duration.Quick}" GeneratedEasingFunction="{StaticResource Ease.Glide}" />
                        <VisualTransition To="Pressed" GeneratedDuration="{StaticResource Duration.Micro}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                             From="-1" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Ease.Glide}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Bevel" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Inert" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource B.TextDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Inert" Opacity="0" Background="{StaticResource B.White.A04}" BorderBrush="{StaticResource B.White.A08}"
                    BorderThickness="1" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.4" Color="{StaticResource C.Iris}" />
                </Border.Effect>
            </Border>
            <Border x:Name="Bevel" Opacity="0.5" Background="{StaticResource Fill.Bevel}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="Hover" Opacity="0" Background="{StaticResource B.White.A12}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <Border x:Name="Sheen" Background="{StaticResource B.White.A40}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" IsHitTestVisible="False">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform X="-1" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Offset="0.35" Color="{StaticResource C.Transparent}" />
                        <GradientStop Offset="0.5" Color="{StaticResource C.Diamond50}" />
                        <GradientStop Offset="0.65" Color="{StaticResource C.Transparent}" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border x:Name="Shade" Opacity="0" Background="{StaticResource B.Black.A40}" CornerRadius="{TemplateBinding theme:Chrome.CornerRadius}" />
            <StackPanel x:Name="Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                <c:IconPresenter x:Name="Icon" Icon="{TemplateBinding theme:Chrome.Icon}" Width="18" Height="18" Margin="0,0,8,0"
                                 StrokeThickness="1.8" VerticalAlignment="Center" />
                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="theme:Chrome.Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.Obsidian950}" />
        <Setter Property="Background" Value="{StaticResource B.Prisma}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Primary}" />
    </Style>
</ResourceDictionary>
